<UserControl x:Class="BrowserExtensionLookup.Views.BulkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input area -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="760"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Paste anything with extension IDs in it: IDs, store URLs, Intune policy lines, CSV, JSON..." FontWeight="SemiBold"
                           FontSize="14" Margin="0,0,0,6"/>
                <TextBox x:Name="IdsBox" Style="{StaticResource ModernTextBox}" Height="88"
                         FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"/>
                <CheckBox x:Name="MatchBox" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                          Content="Also find each extension in the other store (Chrome ID → Edge ID and back). Slower."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="14,24,0,0" VerticalAlignment="Top">
                <Button x:Name="RunButton" Content="Lookup All" Style="{StaticResource AccentButton}"
                        MinWidth="140" Click="Run_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButton}"
                        MinWidth="140" Margin="0,6,0,0" IsEnabled="False" Click="Cancel_Click"/>
                <Button x:Name="ExportButton" Content="Export CSV" Style="{StaticResource GhostButton}"
                        MinWidth="140" Margin="0,6,0,0" IsEnabled="False" Click="Export_Click"/>
            </StackPanel>
        </Grid>

        <!-- Progress -->
        <Grid Grid.Row="1" x:Name="ProgressPanel" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Height="6" Background="#333333"
                         Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
            <TextBlock x:Name="ProgressText" Grid.Column="1" Margin="12,0,0,0" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Results card with split Chrome/Edge accent stripe -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource ChromeBrush}" CornerRadius="6,0,0,0"/>
                    <Border Grid.Column="1" Background="{StaticResource EdgeBrush}" CornerRadius="0,6,0,0"/>
                </Grid>
                <DataGrid x:Name="ResultGrid" Grid.Row="1" Style="{StaticResource DarkGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Extension ID" Binding="{Binding Id}" Width="3*"
                                            ElementStyle="{StaticResource MonoCellText}"/>
                        <DataGridTextColumn Header="Chrome Name" Binding="{Binding ChromeName}" Width="4*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}">
                                    <Setter Property="Foreground" Value="{StaticResource ChromeBrush}"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Chrome" Binding="{Binding ChromeStatus}" Width="140"
                                            ElementStyle="{StaticResource StatusCellText}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}">
                                    <Setter Property="Foreground" Value="{StaticResource ChromeBrush}"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="MV" Binding="{Binding ChromeManifest}" Width="56"
                                            ElementStyle="{StaticResource StatusCellText}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}">
                                    <Setter Property="Foreground" Value="{StaticResource ChromeBrush}"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Edge Name" Binding="{Binding EdgeName}" Width="4*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}">
                                    <Setter Property="Foreground" Value="{StaticResource EdgeBrush}"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Edge" Binding="{Binding EdgeStatus}" Width="140"
                                            ElementStyle="{StaticResource StatusCellText}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}">
                                    <Setter Property="Foreground" Value="{StaticResource EdgeBrush}"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="MV" Binding="{Binding EdgeManifest}" Width="56"
                                            ElementStyle="{StaticResource StatusCellText}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}">
                                    <Setter Property="Foreground" Value="{StaticResource EdgeBrush}"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <!-- Cross-store match columns: shown only when a run used "find in the other store" -->
                        <DataGridTextColumn x:Name="MatchStatusColumn" Header="Match" Binding="{Binding MatchStatus}" Width="150"
                                            ElementStyle="{StaticResource StatusCellText}" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="MatchNameColumn" Header="Match Name" Binding="{Binding MatchName}" Width="3*"
                                            Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="MatchIdColumn" Header="Match ID" Binding="{Binding MatchId}" Width="3*"
                                            ElementStyle="{StaticResource MonoCellText}" Visibility="Collapsed"/>
                        <DataGridTemplateColumn x:Name="MatchCopyColumn" Width="104" MinWidth="104" CanUserResize="False"
                                                Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Only rows with a match get a button, so it can't be confused with the row's own Copy -->
                                    <Button Content="Copy match" Click="CopyMatchId_Click" ToolTip="Copy the other store's ID">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchId}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="72" MinWidth="72" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Copy" Style="{StaticResource CopyButton}" Click="CopyId_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
